# ======================= Playwright system settings ======================= #
#
# Validated in app/constants/env.constants.ts — every value below has a default,
# so an unset variable falls back instead of becoming NaN. Only DEV_BASE_APP_URL
# is required. Applied on CI only (locally the config uses its own defaults).

FULLY_PARALLEL='true'
EXPECT_TIMEOUT=5000
TEST_TIMEOUT=60000
REPEAT=1                 # repeatEach — minimum 1; 0 is not a valid value
RETRIES=1
WORKERS=8
TRACE_VALUE='on-first-retry'
VIDEO_RECORD='retain-on-failure'   # 'off' to skip video capture on CI

# ======================= Test environment settings ======================= #

DOTENV_CONFIG_QUIET=true
CI=false

# Demo defaults below make `npm test` runnable out of the box against public demo
# targets, with zero secrets. Replace both with your own app/API when adopting this
# boilerplate for a real project — see specs/posts-api.md and app/ui/pages/Login.page.ts.
DEV_BASE_APP_URL='http://localhost:5173'   # Vite dev server of the portfolio (started by webServer)
DEV_API_URL='https://jsonplaceholder.typicode.com'

# ======================= Test data settings ======================= #

# ======================= Testomatio ======================= #
#
# Reporter API key. Empty = results are not published; set it to enable the
# @testomatio/reporter entry in playwright.config.ts. Works locally too, which is
# the easiest way to verify the integration before wiring CI.
TESTOMATIO=

# MCP token and project — a DIFFERENT credential, for the Testomat.io MCP server.
# Export them in your shell / OS env, never here. See ai/mcp/README.md.
# TESTOMATIO_MCP_TOKEN=
# TESTOMATIO_PROJECT=
