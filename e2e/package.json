{
  "name": "playwright-ai",
  "version": "1.0.0",
  "description": "Test automation solution based on Playwright and AI",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:ui": "playwright test --project=chromium --ui",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:browsers": "playwright test",
    "test:characterization": "playwright test -c playwright.characterization.config.ts",
    "characterization:check": "node scripts/characterization.mjs",
    "sync:ai": "node scripts/sync-ai.mjs",
    "verify:ai": "node scripts/verify-ai.mjs",
    "catalog:generate": "node scripts/generate-framework-catalog.mjs",
    "gaps": "node scripts/gaps.mjs",
    "handoff": "node scripts/handoff.mjs",
    "typecheck": "tsc --noEmit",
    "lint:contract": "eslint . --max-warnings=0",
    "verify": "npm run typecheck && npm run lint:contract && npm run format:check && npm run verify:ai && npm run characterization:check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "resume:pdf": "node scripts/print-resume.mjs"
  },
  "keywords": [],
  "author": "Kostiantyn Bielozorov",
  "license": "ISC",
  "type": "module",
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.65.1",
    "@testomatio/reporter": "^2.23.0",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.9.0",
    "joi": "^18.2.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
